[gd_scene format=3]

[ext_resource type="Script" path="res://src/widgets/apply_bar.gd" id="1"]

[node name="ApplyBar" type="PanelContainer"]
theme_type_variation = &"ApplyBar"
script = ExtResource("1")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Apply" type="Button" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PrimaryButton"
disabled = true
text = "Apply edits"

[node name="DiscardDrafts" type="Button" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "Discard"

[node name="ApplySummary" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Dim"
text = "No unapplied edits"

[node name="Spacer" type="Control" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="ApplyNote" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Dim"
