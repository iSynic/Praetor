[gd_scene format=3]

[ext_resource type="Script" path="res://src/shell/problems_dock.gd" id="1"]
[ext_resource type="Script" path="res://src/widgets/icon_button.gd" id="2"]

[node name="ProblemsDock" type="PanelContainer"]
theme_type_variation = &"Dock"
script = ExtResource("1")

[node name="ProblemsContent" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Head" type="PanelContainer" parent="ProblemsContent"]
layout_mode = 2
theme_type_variation = &"DockHead"

[node name="Row" type="HBoxContainer" parent="ProblemsContent/Head"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="ProblemsToggle" type="Button" parent="ProblemsContent/Head/Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DockTab"
toggle_mode = true
text = "Problems"

[node name="ProblemsCount" type="Label" parent="ProblemsContent/Head/Row"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"BadgeWarn"
text = "0"

[node name="Capability" type="Button" parent="ProblemsContent/Head/Row"]
layout_mode = 2
theme_type_variation = &"DockTab"
disabled = true
text = "Capability"

[node name="PlayLog" type="Button" parent="ProblemsContent/Head/Row"]
layout_mode = 2
theme_type_variation = &"DockTab"
disabled = true
text = "Play log"

[node name="Find" type="Button" parent="ProblemsContent/Head/Row"]
layout_mode = 2
theme_type_variation = &"DockTab"
disabled = true
text = "Find"

[node name="ProblemsSummary" type="Label" parent="ProblemsContent/Head/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Dim"
text = "Preservation diagnostics"
horizontal_alignment = 2
clip_text = true

[node name="ThisMap" type="Button" parent="ProblemsContent/Head/Row"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"Chip"
disabled = true
text = "This map"

[node name="WholeProject" type="Button" parent="ProblemsContent/Head/Row"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"Chip"
disabled = true
text = "Project"

[node name="CheckProject" type="Button" parent="ProblemsContent/Head/Row"]
layout_mode = 2
size_flags_vertical = 4
disabled = true
text = "Check project"

[node name="Collapse" type="Button" parent="ProblemsContent/Head/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
script = ExtResource("2")
glyph = "chevron_up"

[node name="Problems" type="ScrollContainer" parent="ProblemsContent"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 150)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Inset" type="MarginContainer" parent="ProblemsContent/Problems"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 8

[node name="ProblemRows" type="VBoxContainer" parent="ProblemsContent/Problems/Inset"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6
